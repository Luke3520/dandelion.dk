---
// Small spot icons in the hand-drawn print style (see art/STYLE.md). Decorative.
import { sketchbook, roundedRect, type Mark } from '../lib/sketch';
import SketchMarks from './art/SketchMarks.astro';

export type IconName = 'access' | 'lock' | 'eye' | 'list';
interface Props { name: IconName }
const { name } = Astro.props;

const small = { roughness: 0.45, disableMultiStroke: true, strokeWidth: 1.6 };
const b = sketchbook(100 + ['access', 'lock', 'eye', 'list'].indexOf(name));

if (name === 'access') {
  // The accessibility figure in a circle.
  b.circle(32, 32, 52, 'var(--mist)', { strokeWidth: 2.2 });
  b.circle(32, 17, 7, 'var(--yellow)', small);
  b.curve([[17, 25], [32, 28], [47, 25]], { strokeWidth: 2.2, roughness: 0.6 });
  b.line(32, 28, 32, 40, { strokeWidth: 2.2, roughness: 0.6 });
  b.line(32, 40, 25, 52, { strokeWidth: 2.2, roughness: 0.6 });
  b.line(32, 40, 39, 52, { strokeWidth: 2.2, roughness: 0.6 });
}

if (name === 'lock') {
  b.path('M21 29 V21 C21 8 43 8 43 21 V29', undefined, { strokeWidth: 2.4 });
  b.path(roundedRect(13, 28, 38, 28, 5), 'var(--yellow)', { strokeWidth: 2.2 });
  b.circle(32, 39, 7, 'var(--ink)', small);
  b.line(32, 41, 32, 48, { strokeWidth: 2.6, roughness: 0.3, disableMultiStroke: true });
}

if (name === 'eye') {
  // An eye, crossed out: no tracking.
  b.path('M6 32 C16 17 48 17 58 32 C48 47 16 47 6 32 Z', 'var(--paper)', { strokeWidth: 2.2 });
  b.circle(32, 32, 16, 'var(--leaf)', small);
  b.circle(32, 32, 6, 'var(--ink)', small);
  b.line(12, 54, 52, 10, { strokeWidth: 2.8, roughness: 0.7 });
}

if (name === 'list') {
  // A written overview with ticks.
  b.poly([[14, 8], [48, 6], [50, 58], [16, 58]], 'var(--paper)', { strokeWidth: 2.2 });
  for (const y of [20, 32, 44]) {
    b.path(`M20 ${y} L23 ${y + 3} L28 ${y - 3}`, undefined, { strokeWidth: 2, stroke: 'var(--stem)', roughness: 0.4 });
    b.line(32, y, 44, y - 0.5, { strokeWidth: 1.6 });
  }
  b.patch('M30 40 Q38 37 46 40 Q46 48 38 48 Q30 48 30 40 Z', 'var(--yellow)');
}

const marks: Mark[] = b.marks;
---
<svg class="icon" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <SketchMarks marks={marks} />
</svg>

<style>
  .icon { width: 4.5rem; height: 4.5rem; overflow: visible; }
</style>

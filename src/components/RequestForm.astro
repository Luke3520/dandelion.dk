---
// Posts to the Pages Function in /functions/api/request.ts. Works without JavaScript.
import { ui } from '../i18n/ui';
import { path, type Locale } from '../i18n/routes';

interface Props { kind: 'contact' | 'vega'; locale?: Locale }
const { kind, locale = 'da' } = Astro.props;
const f = ui[locale].form;
const id = (name: string) => `${kind}-${name}`;
---
<form class="request" method="post" action="/api/request">
  <input type="hidden" name="kind" value={kind}>
  <input type="hidden" name="locale" value={locale}>

  <div class="field">
    <label for={id('name')}>{f.name}</label>
    <input id={id('name')} name="name" type="text" autocomplete="name" required maxlength="200">
  </div>
  <div class="field">
    <label for={id('email')}>{f.email}</label>
    <input id={id('email')} name="email" type="email" autocomplete="email" required maxlength="320">
  </div>
  <div class="field">
    <label for={id('organisation')}>{kind === 'vega' ? f.vegaOrganisation : f.organisation} <span class="optional">{f.optional}</span></label>
    <input id={id('organisation')} name="organisation" type="text" autocomplete="organization" maxlength="200">
  </div>
  {kind === 'vega' && (
    <div class="field">
      <label for={id('reach')}>{f.reach} <span class="optional">{f.optional}</span></label>
      <p class="hint" id={id('reach-hint')}>{f.reachHint}</p>
      <input id={id('reach')} name="reach" type="text" maxlength="200" aria-describedby={id('reach-hint')}>
    </div>
  )}

  {kind === 'contact' ? (
    <div class="field">
      <label for={id('topic')}>{f.topic}</label>
      <select id={id('topic')} name="topic">
        {f.topics.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
  ) : (
    <fieldset class="field">
      <legend>{f.requestType}</legend>
      {f.requestTypes.map((o, i) => (
        <label class="choice"><input type="radio" name="topic" value={o.value} checked={i === 0}> {o.label}</label>
      ))}
    </fieldset>
  )}

  <div class="field">
    <label for={id('message')}>{kind === 'vega' ? f.vegaMessage : f.message}</label>
    {kind === 'vega' && <p class="hint" id={id('message-hint')}>{f.vegaHealthNote}</p>}
    <textarea id={id('message')} name="message" rows="6" required maxlength="5000" aria-describedby={kind === 'vega' ? id('message-hint') : undefined}></textarea>
  </div>

  <div class="trap" aria-hidden="true">
    <label for={id('website')}>{f.honeypot}</label>
    <input id={id('website')} name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  {kind === 'vega' && (
    <label class="choice consent"><input type="checkbox" name="consent" value="yes" required> {f.vegaConsent}</label>
  )}

  <p class="privacy">{f.privacyNote} <a href={path('privacy', locale)}>{f.privacyLink}</a>.</p>
  <button class="button dark" type="submit">{f.send}</button>
</form>

<style>
  .request { max-width: 40rem; display: grid; gap: 1.4rem; }
  .field { display: grid; gap: 0.45rem; border: 0; padding: 0; margin: 0; }
  label, legend { font-weight: 700; padding-left: 1.1rem; }
  legend { margin-bottom: 0.4rem; }
  .optional { font-weight: 400; font-size: var(--text-small); color: var(--muted); }
  input[type="text"], input[type="email"], select, textarea {
    font: inherit; color: var(--ink); background: var(--paper);
    border: 1.5px solid var(--ink); border-radius: var(--pill); padding: 0.8rem 1.1rem; width: 100%;
  }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%); background-position: calc(100% - 1.6rem) 55%, calc(100% - 1.2rem) 55%; background-size: 0.4rem 0.4rem; background-repeat: no-repeat; padding-right: 2.5rem; }
  textarea { border-radius: var(--radius); min-height: 9rem; resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; border-color: var(--ink); }
  .choice { font-weight: 400; display: flex; gap: 0.6rem; align-items: flex-start; padding-left: 1.1rem; }
  .choice input { margin-top: 0.3rem; width: 1.15rem; height: 1.15rem; flex: none; accent-color: var(--stem); }
  .hint { color: var(--muted); font-size: var(--text-small); margin: 0; padding-left: 1.1rem; }
  .privacy { color: var(--muted); font-size: var(--text-small); margin: 0; }
  .trap { position: absolute; left: -9999px; }
  .button { justify-self: start; }
  .button.dark { padding-inline: 2.2rem; }
</style>

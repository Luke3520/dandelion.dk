---
// "Plads til at vokse": a dandelion growing up through a crack in the asphalt, drawn as a cross-section
// with the soil and roots underneath. Used for Project Vega. See STYLE.md.
import { sketchbook, seedMarks, leafPoints, type Mark } from '../../lib/sketch';
import SketchMarks from './SketchMarks.astro';

interface Props { label: string }
const { label } = Astro.props;

const SURFACE = 206; // top of the asphalt
const BASE: [number, number] = [206, SURFACE - 2]; // where the plant leaves the crack
const small = { roughness: 0.45, disableMultiStroke: true, strokeWidth: 1.4 };

// Ground: soil, two asphalt slabs and the crack between them.
const g = sketchbook(21);
const soil = 'M8 246 L392 246 L392 312 L8 312 Z';
g.patch(soil, 'var(--mist)');
g.hatch(soil, 'var(--clay)', { hachureGap: 12, hachureAngle: 38, fillWeight: 0.8 });
g.line(8, 312, 392, 312, { strokeWidth: 1.4 });
const leftSlab = `M8 ${SURFACE + 2} L190 ${SURFACE - 1} L196 ${SURFACE + 12} L191 222 L199 236 L194 248 L8 248 Z`;
const rightSlab = `M218 ${SURFACE - 2} L392 ${SURFACE + 3} L392 248 L214 248 L220 236 L212 224 L219 214 Z`;
for (const slab of [leftSlab, rightSlab]) {
  g.path(slab, 'var(--line)');
  g.hatch(slab, 'var(--muted)', { hachureGap: 11, fillWeight: 0.7 });
}
// Pebbles in the asphalt.
for (const [x, y, d] of [[40, 222, 6], [92, 236, 5], [150, 220, 7], [262, 230, 6], [318, 220, 5], [360, 236, 7]]) {
  g.circle(x, y, d, 'var(--paper)', small);
}
// Roots spreading in the soil below the crack.
g.curve([[206, 238], [204, 256], [208, 276], [204, 300]], { strokeWidth: 2, stroke: 'var(--clay)' });
g.curve([[205, 258], [190, 268], [172, 272]], { strokeWidth: 1.3, stroke: 'var(--clay)' });
g.curve([[207, 270], [224, 282], [246, 284]], { strokeWidth: 1.3, stroke: 'var(--clay)' });
g.curve([[205, 286], [194, 296], [182, 302]], { strokeWidth: 1.1, stroke: 'var(--clay)' });
// A drop of water in the crack.
g.path('M206 226 C202 232 202 238 206 238 C210 238 210 232 206 226 Z', 'var(--paper)', { ...small, strokeWidth: 1.2 });

// Leaves spread over the asphalt on both sides.
const leaves = sketchbook(22);
for (const [angle, length, width] of [[-2.95, 112, 20], [-3.35, 84, 16], [-0.18, 118, 21], [0.22, 86, 16], [-2.45, 72, 14]] as const) {
  leaves.poly(leafPoints(BASE[0], BASE[1], length, width, angle), 'var(--leaf)', { strokeWidth: 1.8 });
}

// Stem and flower: this group sways.
const f = sketchbook(23);
f.curve([[BASE[0], BASE[1]], [204, 160], [214, 118], [228, 90]], { strokeWidth: 3, stroke: 'var(--stem)', roughness: 0.6 });
f.poly([[218, 98], [222, 108], [230, 100], [238, 108], [240, 96]], 'var(--leaf)', { strokeWidth: 1.4 });
f.circle(229, 80, 58, 'var(--yellow)', { strokeWidth: 2 });
for (let i = 0; i < 22; i++) {
  const a = (i / 22) * Math.PI * 2;
  const r1 = 9;
  const r2 = 25 + (i % 2) * 3;
  f.line(229 + Math.cos(a) * r1, 80 + Math.sin(a) * r1, 229 + Math.cos(a) * r2, 80 + Math.sin(a) * r2, { strokeWidth: 1.1, roughness: 0.5, disableMultiStroke: true });
}
f.circle(229, 80, 12, 'var(--clay)', small);

// Morning sun and two seeds on the wind.
const sun = sketchbook(24);
sun.circle(70, 66, 40, undefined, { strokeWidth: 1.8 });
for (let i = 0; i < 9; i++) {
  const a = (i / 9) * Math.PI * 2 + 0.2;
  sun.line(70 + Math.cos(a) * 28, 66 + Math.sin(a) * 28, 70 + Math.cos(a) * 38, 66 + Math.sin(a) * 38, { strokeWidth: 1.4, roughness: 0.4, disableMultiStroke: true });
}
const seeds: Mark[][] = [seedMarks(300, 70, 1.2, 25), seedMarks(344, 118, 0.95, 26)];
---
<svg class="crack-flower" viewBox="0 0 400 320" role="img" aria-label={label}>
  <SketchMarks marks={sun.marks} />
  <SketchMarks marks={g.marks} />
  <SketchMarks marks={leaves.marks} />
  <g class="flower"><SketchMarks marks={f.marks} /></g>
  {seeds.map((marks, i) => <g class={`seed s${i + 1}`}><SketchMarks marks={marks} /></g>)}
</svg>

<style>
  .crack-flower { display: block; width: 100%; height: auto; max-width: 32rem; justify-self: center; overflow: visible; }
  .flower { transform-box: view-box; transform-origin: 206px 204px; animation: sway 7s ease-in-out infinite; }
  @keyframes sway { 0%, 100% { transform: rotate(-2deg); } 50% { transform: rotate(2.5deg); } }
  .seed { transform-box: fill-box; transform-origin: center; animation: float 11s ease-in-out infinite; }
  .s2 { animation-duration: 13s; animation-delay: -5s; }
  @keyframes float { 0%, 100% { transform: translate(0, 0) rotate(0deg); } 50% { transform: translate(10px, -8px) rotate(9deg); } }
</style>

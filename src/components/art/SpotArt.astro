---
// Spot drawings for single pages, in the shared style (see STYLE.md). Decorative.
//   lost   404: a seed that has drifted off course, past a signpost.
//   letter contact: a dandelion seed carrying a letter on the wind.
//   desk   about: the studio desk, with a dandelion in a glass.
//   prices prices: an honest price tag, a receipt with ticks and a few coins.
//   work   cases: a pinboard with sketches of the work (bike rental, webshop and till, a housing association).
//   notes  notes: an open notebook with a pressed dandelion.
import { sketchbook, seedMarks, roundedRect, type Mark } from '../../lib/sketch';
import { plant } from '../../lib/plants';
import SketchMarks from './SketchMarks.astro';

export type SpotArtName = 'lost' | 'letter' | 'desk' | 'prices' | 'work' | 'notes';
interface Props { name: SpotArtName }
const { name } = Astro.props;

const small = { roughness: 0.45, disableMultiStroke: true, strokeWidth: 1.5 };
let base: Mark[] = [];
const moving: Record<string, Mark[]> = {};

/** Short dashes along a cubic curve, for flight paths. */
function dashes(b: ReturnType<typeof sketchbook>, p0: number[], p1: number[], p2: number[], p3: number[], count: number) {
  const at = (t: number) => {
    const u = 1 - t;
    return [0, 1].map((k) => u * u * u * p0[k] + 3 * u * u * t * p1[k] + 3 * u * t * t * p2[k] + t * t * t * p3[k]);
  };
  for (let i = 0; i < count; i++) {
    const [x1, y1] = at(i / count);
    const [x2, y2] = at((i + 0.45) / count);
    b.line(x1, y1, x2, y2, { strokeWidth: 1.4, roughness: 0.3, disableMultiStroke: true });
  }
}

if (name === 'lost') {
  const b = sketchbook(301);
  b.line(10, 196, 310, 194, { strokeWidth: 1.8 });
  // Signpost pointing both ways.
  b.rect(176, 60, 8, 136, 'var(--clay)', { strokeWidth: 1.8 });
  b.poly([[118, 70], [176, 66], [176, 92], [118, 96], [104, 83]], 'var(--yellow)');
  b.poly([[184, 98], [244, 100], [258, 114], [244, 128], [184, 126]], 'var(--mist)');
  b.path('M136 76 C136 70 146 70 146 76 C146 81 141 81 141 86', undefined, { strokeWidth: 2.2, roughness: 0.5 });
  b.circle(141, 90.5, 2.5, 'var(--ink)', small);
  b.path('M212 106 C212 100 222 100 222 106 C222 111 217 111 217 116', undefined, { strokeWidth: 2.2, roughness: 0.5 });
  b.circle(217, 120.5, 2.5, 'var(--ink)', small);
  // A seed head missing one seed, and the long way that seed has taken.
  const clock = plant(64, 196, { height: 104, lean: -4, head: 'clock', scale: 0.7, seed: 31 });
  base = [...b.marks, ...clock.rosette, ...clock.top];
  const trail = sketchbook(302);
  dashes(trail, [80, 82], [150, 20], [40, 10], [120, 40], 14);
  dashes(trail, [120, 40], [190, 70], [230, 0], [276, 34], 12);
  base.push(...trail.marks);
  moving.wander = seedMarks(276, 18, 1.2, 303);
}

if (name === 'letter') {
  // Wind lines.
  const w = sketchbook(311);
  w.curve([[24, 70], [60, 62], [96, 72]], { strokeWidth: 1.4, roughness: 0.5 });
  w.curve([[40, 150], [80, 140], [112, 150]], { strokeWidth: 1.4, roughness: 0.5 });
  w.curve([[228, 182], [262, 172], [296, 180]], { strokeWidth: 1.4, roughness: 0.5 });
  base = w.marks;
  // A big seed carrying an envelope on a string.
  const s = sketchbook(312);
  s.line(166, 100, 128, 144, { strokeWidth: 1.4, roughness: 0.4 });
  s.line(166, 100, 204, 144, { strokeWidth: 1.4, roughness: 0.4 });
  s.rect(112, 142, 108, 68, 'var(--paper)', { strokeWidth: 2.2 });
  // Lines on the paper stay dark even when the drawing uses light ink on a dark background.
  s.path('M114 144 L166 182 L218 144', undefined, { strokeWidth: 2, stroke: 'var(--night)' });
  s.circle(166, 182, 12, 'var(--yellow)', { ...small, stroke: 'var(--night)' });
  moving.carrier = [...seedMarks(166, 18, 3.4, 313), ...s.marks];
}

if (name === 'desk') {
  const b = sketchbook(321);
  // Desk top.
  b.line(6, 184, 314, 182, { strokeWidth: 2.2 });
  b.line(30, 184, 30, 214, { strokeWidth: 2 });
  b.line(290, 183, 290, 214, { strokeWidth: 2 });
  // Laptop with a little code on screen.
  b.path(roundedRect(92, 82, 120, 84, 6), 'var(--paper)');
  b.poly([[82, 166], [222, 166], [232, 182], [72, 182]], 'var(--mist)');
  for (const [x1, x2, y] of [[106, 150, 100], [114, 176, 112], [114, 160, 124], [106, 136, 136]]) {
    b.line(x1, y, x2, y, { strokeWidth: 1.6 });
  }
  b.rect(170, 128, 28, 16, 'var(--yellow)', { ...small, strokeWidth: 1.6 });
  // Notebook with a sketch.
  b.poly([[232, 168], [298, 160], [302, 180], [236, 186]], 'var(--paper)', { strokeWidth: 1.8 });
  b.curve([[244, 176], [258, 166], [272, 174], [288, 166]], { strokeWidth: 1.3, stroke: 'var(--stem)' });
  // Mug.
  b.path('M44 140 L47 178 C48 184 70 184 71 178 L74 140 Z', 'var(--clay)');
  b.path('M74 148 C86 148 86 166 72 166', undefined, { strokeWidth: 1.8 });
  // A dandelion in a glass of water.
  b.path('M250 112 L252 158 C252 164 272 164 272 158 L274 112', 'var(--paper)', { strokeWidth: 1.8 });
  b.line(252, 132, 272, 131, { strokeWidth: 1.2, stroke: 'var(--muted)' });
  const flower = plant(262, 150, { height: 98, lean: -10, leaves: false, scale: 0.6, seed: 32 });
  base = [...b.marks];
  moving.flower = flower.top;
  const steam = sketchbook(322);
  steam.curve([[54, 132], [50, 122], [56, 114], [52, 104]], { strokeWidth: 1.4, roughness: 0.5 });
  steam.curve([[64, 132], [60, 120], [66, 112], [62, 100]], { strokeWidth: 1.4, roughness: 0.5 });
  moving.steam = steam.marks;
}
if (name === 'prices') {
  const b = sketchbook(331);
  // Receipt with ticked lines and a total.
  b.path('M150 34 L236 30 L240 186 L230 178 L220 188 L210 178 L200 188 L190 178 L180 188 L170 178 L160 188 L154 180 Z', 'var(--paper)');
  for (const y of [56, 76, 96, 116]) {
    b.path(`M164 ${y} L168 ${y + 4} L175 ${y - 4}`, undefined, { strokeWidth: 1.8, stroke: 'var(--stem)', roughness: 0.4 });
    b.line(182, y, 212, y - 0.5, { strokeWidth: 1.4 });
    b.line(218, y, 228, y, { strokeWidth: 1.4 });
  }
  b.line(162, 136, 230, 135, { strokeWidth: 1.2, stroke: 'var(--muted)' });
  b.line(164, 152, 196, 151, { strokeWidth: 3 });
  b.rect(204, 144, 26, 14, 'var(--yellow)', { ...small, strokeWidth: 1.5 });
  // Coins.
  for (const [x, y] of [[264, 176], [264, 168], [266, 160], [292, 178]]) {
    b.ellipse(x, y, 34, 12, 'var(--clay)', { ...small, strokeWidth: 1.5 });
  }
  base = b.marks;
  // A price tag on a string, swinging a little.
  const t = sketchbook(332);
  t.curve([[118, 18], [112, 34], [104, 50]], { strokeWidth: 1.4, roughness: 0.4 });
  t.poly([[60, 92], [84, 52], [128, 64], [114, 150], [52, 140]], 'var(--yellow)');
  t.circle(92, 66, 9, 'var(--paper)', small);
  t.line(72, 104, 108, 110, { strokeWidth: 3 });
  t.line(70, 120, 98, 124, { strokeWidth: 1.6 });
  moving.tag = t.marks;
}

if (name === 'work') {
  const b = sketchbook(341);
  // Cork board.
  b.round(26, 22, 268, 176, 10, 'var(--clay)');
  b.round(36, 32, 248, 156, 6, undefined, { strokeWidth: 1.4 });
  // Card 1: a bicycle.
  b.poly([[50, 48], [134, 44], [138, 116], [54, 120]], 'var(--paper)', { strokeWidth: 1.8 });
  b.circle(74, 98, 26, undefined, { ...small, strokeWidth: 1.8 });
  b.circle(116, 96, 26, undefined, { ...small, strokeWidth: 1.8 });
  b.path('M74 98 L90 76 L108 78 L116 96 M90 76 L98 96 L108 78 M86 70 L96 70 M108 78 L106 68 L114 66', undefined, { strokeWidth: 1.6, roughness: 0.6 });
  b.circle(92, 46, 7, 'var(--yellow)', small);
  // Card 2: a webshop talking to a till.
  b.poly([[150, 40], [236, 46], [232, 112], [146, 108]], 'var(--paper)', { strokeWidth: 1.8 });
  b.rect(160, 58, 30, 22, 'var(--mist)', { ...small, strokeWidth: 1.4 });
  b.rect(198, 60, 24, 34, 'var(--mist)', { ...small, strokeWidth: 1.4 });
  b.curve([[176, 84], [184, 96], [200, 98]], { strokeWidth: 1.4 });
  b.circle(192, 44, 7, 'var(--yellow)', small);
  // Card 3: a house, and sound waves for a screen reader.
  b.poly([[96, 126], [176, 122], [180, 184], [100, 188]], 'var(--paper)', { strokeWidth: 1.8 });
  b.poly([[116, 176], [116, 150], [136, 134], [156, 150], [156, 176]], 'var(--mist)', { strokeWidth: 1.6 });
  b.rect(130, 158, 12, 18, undefined, { ...small, strokeWidth: 1.4 });
  b.path('M162 146 C168 150 168 158 162 162 M168 140 C178 148 178 160 168 168', undefined, { strokeWidth: 1.4, roughness: 0.4 });
  b.circle(138, 124, 7, 'var(--yellow)', small);
  // A note stuck on the side.
  b.poly([[204, 128], [270, 124], [272, 176], [206, 180]], 'var(--yellow)', { strokeWidth: 1.6 });
  b.line(216, 142, 258, 140, { strokeWidth: 1.4 });
  b.line(216, 154, 250, 152, { strokeWidth: 1.4 });
  b.line(216, 166, 240, 165, { strokeWidth: 1.4 });
  base = b.marks;
  moving.seed = seedMarks(282, -6, 1.1, 342);
}

if (name === 'notes') {
  const b = sketchbook(351);
  // An open notebook.
  b.path('M40 52 C80 40 128 44 160 60 L160 196 C128 180 80 176 40 188 Z', 'var(--paper)');
  b.path('M160 60 C192 44 240 40 280 52 L280 188 C240 176 192 180 160 196 Z', 'var(--paper)');
  for (let i = 0; i < 6; i++) {
    const y = 80 + i * 16;
    b.line(58, y, 144, y + 4, { strokeWidth: 1.3 });
  }
  b.line(58, 70, 120, 70, { strokeWidth: 3 });
  // A pressed dandelion on the right page.
  const pressed = plant(220, 176, { height: 92, lean: 8, leaves: false, scale: 0.55, seed: 52 });
  b.patch('M196 74 Q236 64 252 92 Q258 132 244 166 Q214 176 198 150 Q186 110 196 74 Z', 'var(--mist)');
  base = [...b.marks, ...pressed.top];
  // Pencil resting across the spine.
  const p = sketchbook(352);
  p.poly([[132, 210], [246, 150], [254, 162], [140, 222]], 'var(--yellow)', { strokeWidth: 1.6 });
  p.poly([[132, 210], [140, 222], [124, 224]], 'var(--paper)', { strokeWidth: 1.4 });
  moving.pencil = p.marks;
}
---
<svg class:list={['spot-art', name]} viewBox="0 0 320 220" aria-hidden="true" focusable="false">
  <SketchMarks marks={base} />
  {Object.entries(moving).map(([group, marks]) => <g class={group}><SketchMarks marks={marks} /></g>)}
</svg>

<style>
  .spot-art { display: block; width: 100%; height: auto; overflow: visible; }
  .spot-art :global(g) { transform-box: fill-box; transform-origin: center; }
  .lost :global(.wander) { animation: wander 8s ease-in-out infinite; }
  @keyframes wander { 0%, 100% { transform: translate(0, 0) rotate(-6deg); } 50% { transform: translate(6px, -8px) rotate(8deg); } }
  .letter :global(.carrier) { animation: carry 7s ease-in-out infinite; }
  @keyframes carry { 0%, 100% { transform: translate(0, 0) rotate(-2deg); } 50% { transform: translate(8px, -7px) rotate(2deg); } }
  .desk :global(.flower) { transform-origin: 50% 100%; animation: nod 8s ease-in-out infinite; }
  @keyframes nod { 0%, 100% { transform: rotate(-2deg); } 50% { transform: rotate(2deg); } }
  .prices :global(.tag) { transform-origin: 70% 0%; animation: swing 6s ease-in-out infinite; }
  @keyframes swing { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
  .work :global(.seed) { animation: wander 9s ease-in-out infinite; }
  .notes :global(.pencil) { animation: rest 7s ease-in-out infinite; }
  @keyframes rest { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-3px, 2px); } }
  .desk :global(.steam) { animation: steam 4s ease-in-out infinite; }
  @keyframes steam { 0%, 100% { transform: translateY(0); opacity: 0.9; } 50% { transform: translateY(-5px); opacity: 0.4; } }
</style>

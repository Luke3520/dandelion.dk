---
interface Props { title: string; text: string; href: string; label: string; price?: string }
const { title, text, href, label, price } = Astro.props;
---
<section class="band">
  <div class="wrap inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="side">
      {price && <p class="price display">{price}</p>}
      <a class="button dark" href={href}>{label}</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--yellow); padding: var(--section) 0; }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 4rem; align-items: end; }
  h2 { margin-bottom: 1rem; }
  p { max-width: var(--measure); margin: 0; font-size: var(--lede); }
  .side { text-align: right; }
  .price { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin-bottom: 1rem; }
  .band :focus-visible { outline-color: var(--ink); }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } .side { text-align: left; } }
</style>
